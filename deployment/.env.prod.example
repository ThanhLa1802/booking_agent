# Production environment — copy to deployment/.env and fill in.
#   cp deployment/.env.prod.example deployment/.env
# Never commit deployment/.env (gitignored).

# Public domain (must match the DNS A record + Let's Encrypt cert)
DOMAIN=exam.example.com
EMAIL=ops@example.com

# Shared JWT signing key — Django issues tokens, FastAPI validates them.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret

# PostgreSQL
DB_NAME=trinity
DB_USER=trinity
DB_PASSWORD=change-me-strong-db-password

# Redis (password required in prod)
REDIS_PASSWORD=change-me-strong-redis-password

# AI provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...

# Tuning (optional)
GUNICORN_WORKERS=3
FASTAPI_WORKERS=1
CELERY_CONCURRENCY=2

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
