{
  "rest": {
    "RestGenerator": {
      "name": "trinity-agent",
      "uri": "http://localhost:8010/scan",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "text",
      "request_timeout": 120
    }
  }
}
